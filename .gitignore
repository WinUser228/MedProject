## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.


# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/*
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg
packages/

# The packages folder can be ignored because of Package Restore
/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!/[Pp]ackages/build/

# Azure Functions localsettings file
local.settings.json

# SQL Server files
*.mdf
*.ldf

# Node.js
node_modules/
npm-debug.log

# Other
*.cache
*.pid
*.seed
*.DS_Store
*.sql
*.sqlite

# Rider IDE
.idea/

# VS Code
.history/

# Build results for WPF
_ReSharper.*
*.pdb
*.cache

# WPF temp files
*.opensdf
*.sdf

# WPF publish output
publish/

# Web API temp files
appsettings.Development.json
appsettings.Local.json

# Ignore local launch settings for Web API
Properties/launchSettings.json

# Ignore local secrets (use User Secrets for development)
secrets.json

# Ignore Rider/Resharper specific files
_ReSharper.Caches/
*.DotSettings.user

# OS generated files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini