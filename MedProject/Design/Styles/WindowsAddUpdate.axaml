<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="TextBox">
    <Setter Property="Margin" Value="0,5,0,5" />
    <Setter Property="MinHeight" Value="25" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Не задавайте глобально Height для TextBlock: стиль подключается в App.axaml
       и обрезает многострочный текст (справка Markdown, подсказки ошибок с переносом).
       В формах выравнивание подписей к полям задаётся локально (VerticalAlignment и т.д.). -->

  <Style Selector="DatePicker">
    <Setter Property="Margin" Value="0,5,0,5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="CalendarDatePicker">
    <Setter Property="Margin" Value="0,5,0,5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Margin" Value="0,5,0,5" />
    <Setter Property="Height" Value="25" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</Styles>
