<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MedProject.ViewModels.TabViewModels"
             xmlns:ctrl="clr-namespace:MedProject.Controls"
             x:Class="MedProject.Views.TabViews.HelpView"
             x:DataType="vm:HelpViewModel"
             x:CompileBindings="False">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Без LineHeight у крупного SemiBold текст часто визуально обрезается по выносным элементам букв (сверху/снизу). -->
    <TextBlock Grid.Row="0"
               Text="Справка"
               FontSize="28"
               FontWeight="SemiBold"
               LineHeight="40"
               Padding="0,2,0,4"
               Margin="0,0,0,20"
               Foreground="#333333"/>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="15"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0"
                   Text="Содержание"
                   FontWeight="Bold"
                   FontSize="16"
                   LineHeight="24"
                   Padding="0,1,0,2"
                   Margin="0,0,0,10"
                   Foreground="#555555"/>
        <!-- Grid.Row=* задаёт списку ограниченную высоту; иначе в StackPanel измерение строк ломается и пункты визуально наезжают друг на друга -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding HelpTopics}"
                 SelectedItem="{Binding SelectedTopic}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="MinHeight" Value="40"/>
              <Setter Property="Padding" Value="4,6"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
            <Style Selector="ListBoxItem TextBlock">
              <Setter Property="Foreground" Value="#2C2C2C"/>
              <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style Selector="ListBoxItem:selected TextBlock">
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Title}"
                         Padding="4,4"
                         TextWrapping="Wrap"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- ClipToBounds обрезал многострочный текст таблиц Markdown у границы карточки -->
      <Border Grid.Column="2"
              MinWidth="200"
              BorderBrush="#CCCCCC"
              BorderThickness="1"
              CornerRadius="8"
              Background="White"
              ClipToBounds="False">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch">
          <ctrl:MarkdownViewer Text="{Binding CurrentHelpText}"
                               Padding="20,16"
                               HorizontalAlignment="Stretch"
                               MinWidth="0"/>
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,25,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="10"
                  IsVisible="{Binding ShowBackupRestoreButtons}">
        <Button Command="{Binding BackupCommand}"
                Padding="14,8">
          <ToolTip.Tip>Создать резервную копию базы данных в выбранную папку</ToolTip.Tip>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="&#128190;" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock Text="Создать резервную копию БД" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding RestoreCommand}"
                Padding="14,8">
          <ToolTip.Tip>Заменить текущую базу выбранным файлом резервной копии (с перезапуском приложения)</ToolTip.Tip>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="&#128260;" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock Text="Восстановить БД" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
