<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:addVm="clr-namespace:MedProject.ViewModels.AddViewModels"
             xmlns:editVm="clr-namespace:MedProject.ViewModels.EditModelView"
             x:Class="MedProject.Views.ViewEnterForm.BedTypeEnterFormView"
             x:CompileBindings="False">

  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type addVm:AddBedTypeViewModel}">
      <Border Margin="10" Padding="10" BorderBrush="#AAAAAA" BorderThickness="1" CornerRadius="4">
        <Grid MinWidth="380">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Добавить тип койки"
                     FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Название:"
                     Width="150" VerticalAlignment="Top" Margin="0,6,10,5"/>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,5">
            <TextBox x:Name="AddBedTypeNameBox"
                     Text="{Binding BedTypeName}"
                     MinWidth="200"/>
            <ItemsControl ItemsSource="{Binding (DataValidationErrors.Errors), ElementName=AddBedTypeNameBox}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="#D32F2F" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Button Grid.Row="2" Grid.Column="1"
                  Content="Добавить"
                  Width="87"
                  HorizontalAlignment="Right"
                  Margin="0,10,0,0"
                  Command="{Binding AddBedTypeCommand}"/>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type editVm:EditBedTypeViewModel}">
      <Border Margin="10" Padding="10" BorderBrush="#AAAAAA" BorderThickness="1" CornerRadius="4">
        <Grid MinWidth="380">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Редактировать тип койки"
                     FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Название:"
                     Width="150" VerticalAlignment="Top" Margin="0,6,10,5"/>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,5">
            <TextBox x:Name="EditBedTypeNameBox"
                     Text="{Binding BedTypeName}"
                     MinWidth="200"/>
            <ItemsControl ItemsSource="{Binding (DataValidationErrors.Errors), ElementName=EditBedTypeNameBox}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="#D32F2F" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Button Grid.Row="2" Grid.Column="1"
                  Content="Обновить"
                  Width="87"
                  HorizontalAlignment="Right"
                  Margin="0,10,0,0"
                  Command="{Binding UpdateBedTypeCommand}"/>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <ContentControl Content="{Binding}"/>
</UserControl>
